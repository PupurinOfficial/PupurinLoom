---
import { site, nav } from '../config'
import Icon from './Icon.astro'

const base = import.meta.env.BASE_URL
---
<nav class="site-nav">
  <a class="nav-brand" href="#top">
    <img src={`${base}pupurin-logo.png`} alt={site.name} />
    <span>{site.name}</span><small>{site.nameEn}</small>
  </a>
  <div class="nav-links">
    {nav.map((n) => <a href={`#${n.id}`}>{n.label}</a>)}
    <a class="nav-gh" href={site.urls.appRepo} target="_blank" rel="noopener">
      <Icon name="github" size={15} /> GitHub
    </a>
  </div>
</nav>
